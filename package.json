{
  "name": "fatura-otica-workspace",
  "private": true,
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "start:frontend": "npm --prefix frontend run start",
    "lint:frontend": "npm --prefix frontend run lint",
    "build:backend": "dotnet build backend/FaturaOtica.slnx",
    "test:backend": "dotnet test backend/FaturaOtica.slnx",
    "graph:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/graphify.ps1 update .",
    "graph:query": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/graphify.ps1 query",
    "graph:explain": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/graphify.ps1 explain",
    "quality:backend": "pwsh -NoProfile -File scripts/test-backend.ps1 -Level Feature",
    "quality:backend:bootstrap": "pwsh -NoProfile -File scripts/test-backend.ps1 -Level Bootstrap"
  }
}
